<article class="reading">
  <a class="back" href="<%= url_for('/') %>#writing">← 全部文章</a>
  <header class="story-head">
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p><%= page.description %></p><% } %>
    <div class="byline"><a href="<%= url_for('/') %>"><%= config.author %></a> / <time datetime="<%= date(page.date, 'YYYY-MM-DD') %>"><%= date(page.date, 'YYYY.MM.DD') %></time></div>
  </header>
  <div class="prose"><%- page.content %></div>
</article>
